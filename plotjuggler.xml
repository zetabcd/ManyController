 <customMathEquations>
  <snippet name="roll">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm21 = 2 * (w * x + y * z)
dcm22 = w*w - x*x - y*y + z*z

roll = math.atan(dcm21, dcm22)

return roll</function>
   <linked_source>/fmu/out/vehicle_attitude/q.0</linked_source>
   <additional_sources>
    <v1>/fmu/out/vehicle_attitude/q.1</v1>
    <v2>/fmu/out/vehicle_attitude/q.2</v2>
    <v3>/fmu/out/vehicle_attitude/q.3</v3>
   </additional_sources>
  </snippet>
  <snippet name="pitch">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm20 = 2 * (x * z - w * y)

pitch = math.asin(-dcm20)

return pitch</function>
   <linked_source>/fmu/out/vehicle_attitude/q.0</linked_source>
   <additional_sources>
    <v1>/fmu/out/vehicle_attitude/q.1</v1>
    <v2>/fmu/out/vehicle_attitude/q.2</v2>
    <v3>/fmu/out/vehicle_attitude/q.3</v3>
   </additional_sources>
  </snippet>
  <snippet name="yaw">
   <global></global>
   <function>w = value
x = v1
y = v2
z = v3

dcm10 = 2 * (x * y + w * z)
dcm00 = w*w + x*x - y*y - z*z

yaw = math.atan(dcm10, dcm00)

return yaw</function>
   <linked_source>/fmu/out/vehicle_attitude/q.0</linked_source>
   <additional_sources>
